    "screen": {
      "px": 20,
      "usage": "rare screen-level title"
    },
    "panel": {
      "px": 18,
      "usage": "panel/local screen title"
    },
    "section": {
      "px": 16,
      "usage": "section heading only when needed"
    },
    "body": {
      "px": 14,
      "usage": "body, controls, values"
    },
    "support": {
      "px": 12,
      "usage": "labels, metadata, captions"
    },
    "scalePx": [
      12,
      14,
      16,
      18,
      20,
      24
    ],
    "rule": "Internal Admin uses 24/20/18/16/14/12 only. Do not create 11.5/13/15/17/22px hierarchy levels in new internal UI.",
    "approvedExceptions": {
      "loginBrand": "24px",
      "mobileTextInput": "16px minimum when browser zoom prevention requires it"
    }
  },
  "radii": {
    "scalePx": [
      4,
      6,
      8
    ],
    "defaultPanelPx": 8,
    "controlPx": 6,
    "smallPx": 4,
    "pill": "999px",
    "rule": "Do not add new radius levels without updating SSOT."
  },
  "surfaces": {
    "canvas": "#F2F6FC",
    "panel": "#FFFFFF",
    "component": "#F7F9FC",
    "soft": "#F5F7FA",
    "hover": "#F3F6FA",
    "selected": "#EAF1FF",
    "brand": "#1B2A4A",
    "lineFree": true,
    "hierarchy": "canvas -> panel -> component/card -> selected/interaction",
    "rule": "Panel and Card must not share the same resting surface; do not compensate with stronger shadows."
  },
  "controls": {
