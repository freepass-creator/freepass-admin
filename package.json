{
  "name": "freepass-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "uiux:map": "node scripts/check-uiux-consumer.mjs",
    "ui:check": "tsx scripts/check-ui-ssot.mts",
    "data:check": "tsx scripts/check-live-data-wiring.mts",
    "deploy:check": "tsx scripts/check-deploy-env.mts",
    "test:contract-firestore": "tsx --test src/adapters/erp5/__tests__/contract-termination-firestore.integration.ts",
    "test:intake-firestore": "tsx --test src/adapters/erp5/__tests__/intake-catalog-firestore.integration.ts",
    "test:freepass-data-firestore": "tsx --test src/adapters/erp5/__tests__/contract-termination-firestore.integration.ts src/adapters/erp5/__tests__/intake-catalog-firestore.integration.ts",
    "postinstall": "node scripts/install-pdf-fonts.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "149.0.0",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^10.9.1",
    "next": "16.3.6",
    "pretendard": "1.3.9",
    "puppeteer-core": "25.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  }
}
