{
  "name": "freepasserp.com",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "test:rules": "firebase emulators:exec --only firestore --project demo-freepasserp-v1 \"node --import tsx --test test/firestore-rules.test.ts\"",
    "test:all": "npm test && npm run test:rules"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^14.22.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
}
