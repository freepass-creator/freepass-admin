{
  "name": "freepass-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "f04:basis": "node scripts/f04-basis-from-notes.mjs --dry-run",
    "f04:basis:test": "node scripts/f04-basis-from-notes.mjs --self-test",
    "dev": "next dev",
    "build": "node --import tsx scripts/check-deploy-env.mts --vercel-build && next build",
    "start": "next start",
    "typecheck": "npm run check:data-authority && tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "ui:check": "tsx scripts/check-ui-ssot.mts",
    "data:check": "tsx scripts/check-live-data-wiring.mts",
    "settlement:pdf": "tsx scripts/generate-monthly-settlement-pdf.mts",
    "test:contract-firestore": "tsx --test src/adapters/erp5/__tests__/contract-termination-firestore.integration.ts",
    "test:intake-firestore": "tsx --test src/adapters/erp5/__tests__/intake-catalog-firestore.integration.ts",
    "test:freepass-data-firestore": "tsx --test src/adapters/erp5/__tests__/contract-termination-firestore.integration.ts src/adapters/erp5/__tests__/intake-catalog-firestore.integration.ts",
    "postinstall": "node scripts/install-fonts.mjs",
    "visual:qa": "node scripts/visual-qa.cjs",
    "deploy:check": "tsx scripts/check-deploy-env.mts",
    "test:identity-journey": "tsx --test scripts/check-identity-journey.mts",
    "identity:journey": "firebase emulators:exec --only auth,firestore --project freepasserp5 \"npm run test:identity-journey\"",
    "local:emulators": "firebase emulators:start --only auth,firestore --project freepasserp5",
    "local:approve": "tsx scripts/local-approve.mts",
    "local:setup": "tsx scripts/local-setup.mts",
    "check:data-authority": "node scripts/check-freepass-data-authority.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "149.0.0",
    "@vercel/oidc": "3.8.9",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^10.9.1",
    "next": "16.3.8",
    "pretendard": "1.3.9",
    "puppeteer-core": "25.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "jose": "^5.10.0"
  }
}
