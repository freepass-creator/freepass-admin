# FreePass Admin environment contract
#
# Never copy credentials from freepasserp4 or any legacy project.
# ERP5 binding is explicit and fail-closed.

# Development default: file
# Production must explicitly select erp5 or remains unbound.
FPA_REPOSITORY_MODE=file
FPA_DATA_DIR=.data
FPA_DEV_ACTOR_ID=dev-admin

# ERP5 read/write binding
# FPA_REPOSITORY_MODE=erp5
# ERP5_FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"freepasserp5",...}
# or local development only:
# ERP5_SERVICE_ACCOUNT_PATH=/secure/path/freepasserp5-service-account.json

# Required before Admin-owned write collections can be used.
# This creates/uses only namespaced Admin collections such as
# <namespace>_applications, <namespace>_performances, <namespace>_settlements.
# ERP5_ADMIN_NAMESPACE=freepass_admin_v1

# Write gate. Omit/off = all Admin ERP5 mutations fail closed.
# ERP5_WRITE=on

# Production authentication is intentionally NOT configured by the persistence flags above.
# A production Actor/Auth adapter remains a separate required gate.
