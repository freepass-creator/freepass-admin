# FreePass Admin operational environment contract (2026-09-27)
# Values below are placeholders, not working production credentials.
# Provision approved secrets in the deployment project; never commit .env.local.
# FreePass Data is the only Firebase/Firestore business-data access authority.

FREEPASS_DATA_ADMIN_CATALOG_READ_MODE=OBSERVE
# All operational business-data reads/writes go through FreePass Data.
# OBSERVE keeps the current compatibility shape, but the transport is FreePass Data.
# Final semantic catalog cutover still requires an approved Admin projection, parity and ACTIVE release.
# FREEPASS_DATA_BASE_URL=https://<private-freepass-data-admin-run-url>
# FREEPASS_DATA_ADMIN_CATALOG_TOKEN=<32+ char consumer token>
# Private Cloud Run caller authentication from Vercel:
# FREEPASS_DATA_GCP_WIF_AUDIENCE=//iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
# FREEPASS_DATA_GCP_CALLER_SERVICE_ACCOUNT_EMAIL=<caller>@freepasserp5.iam.gserviceaccount.com
# VERCEL_OIDC_TOKEN is supplied by Vercel at runtime.
# FREEPASS_DATA_CLOUD_RUN_ID_TOKEN=<diagnostic-only short-lived token; not production SSOT>
FREEPASS_DATA_ADMIN_WORKFLOW_WRITE=off
# SHADOW_READ / PARITY_VERIFIED / FREEPASS_DATA_READ require a non-secret cutover approval receipt
# that matches the exact Data origin + token SHA-256 and the central consumer evidence contract.
# FREEPASS_DATA_ADMIN_CUTOVER_JSON={"consumerId":"freepass-admin-catalog","fromStage":"OBSERVE","targetStage":"SHADOW_READ","baseOrigin":"https://data.example.com","tokenSha256":"<sha256>","evidence":{"contractReady":true,"authenticationVerified":true,"legacyReadVerified":true,"freepassReadVerified":true,"parityVerified":false,"fallbackVerified":false,"productionReadbackVerified":false,"approvedRelease":null},"holdReasons":[],"approvalRef":"ops-cutover-ref","approvedAt":"2026-09-27T00:00:00.000Z","validUntil":"2026-10-04T00:00:00.000Z"}

# Admin-side workflow switch. Both this and FreePass Data's server-side workflow write gate
# must be on before operational writes are accepted.
ERP5_WRITE=off
# IAM / backup / restore evidence belongs to the FreePass Data control plane.
# ERP5_FIREBASE_SERVICE_ACCOUNT_JSON and ERP5_SERVICE_ACCOUNT_PATH are forbidden in Admin production.

# The only production login: approved Google Workspace OAuth.
GOOGLE_WORKSPACE_DOMAIN=teamjpk.com
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SESSION_SECRET=   # independent random secret, minimum 32 characters
# APP_BASE_URL=     # approved HTTPS Admin origin; callback: /login/google/callback

# Retired: ERP3/Firebase email-password Admin login.
# AUTH_PROJECT_ID · AUTH_FIREBASE_SERVICE_ACCOUNT_JSON · AUTH_SERVICE_ACCOUNT_PATH · FIREBASE_WEB_API_KEY
# · ADMIN_EMAILS · ADMIN_UIDS are no longer read. Remove them from deployed environments.
# Production authentication is always enforced; do not create a bypass for deployment.
# ADMIN_AUTH=on   # local dev only: enforce login outside production as well

# Set both to the approved HTTPS Admin origin before issuing external links.
# PUBLIC_BASE_URL=
# CLAIM_LINK_BASE=
# NEXT_PUBLIC_APP_URL=   # legacy fallback for PUBLIC_BASE_URL; prefer PUBLIC_BASE_URL

# E-sign is outside the launch scope. Admin list, customer /sign links and e-sign APIs return 404 unless on.
ESIGN_ENABLED=off

# Final PDF renderer controls have safe bounded defaults.
# ESIGN_PDF_RENDER_TIMEOUT_MS=45000
# ESIGN_PDF_LAUNCH_TIMEOUT_MS=30000
# ESIGN_PDF_TOTAL_TIMEOUT_MS=65000
# ESIGN_CHROMIUM_EXECUTABLE_PATH=   # optional local Chromium; serverless uses @sparticuz/chromium
# Never set emulator host variables (FIRESTORE_EMULATOR_HOST, FIREBASE_STORAGE_EMULATOR_HOST) in production.
# FPA_DEMO=on is development/preview only and must never be bound to production.
