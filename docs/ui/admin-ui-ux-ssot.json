    },
    "roles": [
      "LIST",
      "DETAIL",
      "WORK"
    ],
    "layouts": {
      "products": "wide list (2 columns) + detail",
      "intake": "product list + product detail + intake/work",
      "performance": "installment performance + detail + paid performance",
      "settlement": "billing list + settlement detail + payout list",
      "esign": "contract list + contract detail"
