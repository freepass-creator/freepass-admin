# FreePass Admin environment contract
#
# 2026-09-19: production persistence/auth bindings are not verified.
# Do not copy credentials from freepasserp4 or any legacy project.
# Add only explicitly approved environment keys when the corresponding
# Adapter/Connector is implemented and documented in docs/SSOT.md.

# Product Catalog authority is FreePass Data.
# Current approved Admin stage is OBSERVE. This still serves the explicit freepasserp5 legacy bridge.
# Do not set SHADOW_READ/PARITY_VERIFIED/FREEPASS_DATA_READ until the Admin-specific FreePass Data contract is active.
FREEPASS_DATA_ADMIN_CATALOG_READ_MODE=OBSERVE

# SHADOW_READ server-to-server connection. Token belongs in server secret storage only.
# FREEPASS_DATA_BASE_URL=https://data.internal.example
# FREEPASS_DATA_ADMIN_CATALOG_TOKEN=<distinct >=32-char service token>
