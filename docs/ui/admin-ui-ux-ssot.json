  "rules": {
    "onePrimaryPerPanel": true,
    "visibleBorders": false,
    "listSelectionBySurface": true,
    "badgeIsSignalNotControl": true,
    "passiveCardHasNoHover": true,
    "interactiveOnlyHoverPress": true,
    "mobileOnePanelAtATime": true,
    "doNotCreateNewVisualScaleWithoutUpdatingSSOT": true,
    "geometryFreezeForPolish": true
  },
  "knownDebt": [
    "globals.css still contains historical/legacy visual values below the current final layer",
    "generated erp-standard.css still contains upstream 22/17/15/13/11.5 and 28/32/34 values; FreePass Admin overrides them in shell.css while validating the new product scale",
    "PC _erp and mobile _design remain two implementation generations sharing one semantic contract",
    "some legacy public/login surfaces retain their own shells and are explicit exceptions"
  ],
  "implementedFixes": [
    "Line-free surface hierarchy: canvas #F2F6FC, white web panels, screen-flat mobile panels",
    "Signal/action/selection semantics separated for Badge, Button, QuickFilter and Card",
    "Desktop typography normalized to 24/20/18/16/14/12 through consumer override",
    "Desktop control tiers normalized to 32 small / 36 standard / 40 row / 56 topbar",
    "Mobile controls remain 44px with 44px minimum touch target",
    "Spacing uses 4/8/12/16/20/24/32 scale; shared panel padding normalized from 22 to 20",
    "Radius scale remains 4/6/8/pill",
    "Elevation remains 0/base/hover/float",
    "Web shell uses topbar + sidenav + multi-panel workspace + statusbar",
    "Mobile shell has no global topbar and uses panel-first navigation",
    "Internal Admin pages are guarded from page-local visual systems",
    "Panel and Card surfaces separated: canvas #F2F6FC -> panel #FFFFFF -> component/card #F7F9FC",
    "Live product perk detail text normalized from legacy 13px to 14px body scale"
  ],
  "automation": {
    "command": "npm run ui:check",
    "workflow": ".github/workflows/ci.yml",
    "checks": [
      "shared markup primitives are not reimplemented in core routes",
      "internal Admin files do not add stable inline visual values or page-local style blocks",
      "mobile panels declare list/detail/work semantic roles",
      "mobile baseline remains 18/14/12 with 44px control/action/touch",
      "desktop normalized scale remains 24/20/18/16/14/12 and 32/36/40/56",
      "spacing/radius/elevation token scales remain constrained",
      "focus-visible and reduced-motion behavior remain present"
    ]
  },
  "accessibility": {
    "focusVisible": true,
    "reducedMotion": true,
    "filterSheetFocusReturn": true,
    "uniqueDialogIds": true,
    "tabSemantics": true,
    "selectedRowSemantics": true,
    "busyStates": true
