# FreePass Admin environment contract
#
# 2026-09-19: production persistence/auth bindings are not verified.
# Do not copy credentials from freepasserp4 or any legacy project.
# Add only explicitly approved environment keys when the corresponding
# Adapter/Connector is implemented and documented in docs/SSOT.md.

# ERP5 Firestore read runtime
# Hosted: set the JSON secret. Local: set a service-account path, or authenticate ADC with
# `gcloud auth application-default login` and keep the project pinned to freepasserp5 in code.
ERP5_FIREBASE_SERVICE_ACCOUNT_JSON=
ERP5_SERVICE_ACCOUNT_PATH=
# Writes remain disabled unless this is explicitly set to on.
ERP5_WRITE=off
