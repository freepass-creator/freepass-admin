{
  "version": "2026-09-18",
  "status": "NORMATIVE",
  "authority": [
    "latest-user-decision",
    "docs/ui/ADMIN-UI-UX-SSOT.md",
    "src/app/_design/*",
    "src/app/globals.css final rules",
    "docs/ui/UI-SPEC.md",
    "mockups-and-history"
  ],
  "typography": {
    "title": {
      "px": 18,
      "token": "--글제목"
    },
    "main": {
      "px": 14,
      "token": "--글메인"
    },
    "support": {
      "px": 12,
      "token": "--글보조"
    },
    "approvedExceptions": {
      "ciWordmark": "~20px",
      "loginBrand": "24px",
      "mobileTextInput": "16px",
      "whiteLabelPerkDetail": "13px",
      "whiteLabelPerkCompact": "12px"
    }
  },
  "radii": {
    "defaultPx": 4,
    "whiteLabelIdentityBadgePx": 8
