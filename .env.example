# FreePass Admin operational environment contract (2026-09-25)
# Values below are placeholders, not working production credentials.
# Provision approved secrets in the deployment project; never commit .env.local.
# The Catalog authority is FreePass Data. Admin owns workflow commands and audit.

FREEPASS_DATA_ADMIN_CATALOG_READ_MODE=OBSERVE
# OBSERVE serves the explicit read-only freepasserp5 legacy catalog bridge.
# Final catalog cutover requires an approved Admin contract, parity and ACTIVE release.
# FREEPASS_DATA_BASE_URL=
# FREEPASS_DATA_ADMIN_CATALOG_TOKEN=
# SHADOW_READ / PARITY_VERIFIED / FREEPASS_DATA_READ require a non-secret cutover approval receipt
# that matches the exact Data origin + token SHA-256 and the central consumer evidence contract.
# FREEPASS_DATA_ADMIN_CUTOVER_JSON={"consumerId":"freepass-admin-catalog","fromStage":"OBSERVE","targetStage":"SHADOW_READ","baseOrigin":"https://data.example.com","tokenSha256":"<sha256>","evidence":{"contractReady":true,"authenticationVerified":true,"legacyReadVerified":true,"freepassReadVerified":true,"parityVerified":false,"fallbackVerified":false,"productionReadbackVerified":false,"approvedRelease":null},"holdReasons":[],"approvalRef":"ops-cutover-ref","approvedAt":"2026-09-26T00:00:00.000Z","validUntil":"2026-10-03T00:00:00.000Z"}

# Shared FreePass Data Firestore project: freepasserp5.
# Set JSON in the deployment secret store OR a local approved key-file path, never both.
# ERP5_FIREBASE_SERVICE_ACCOUNT_JSON=
# ERP5_SERVICE_ACCOUNT_PATH=
ERP5_WRITE=off
# Production ERP5_WRITE=on is fail-closed unless this non-secret approval receipt is present.
# It records that least-privilege IAM and backup/restore were verified before writes opened.
# ERP5_WRITE_APPROVAL_JSON={"projectId":"freepasserp5","iamVerified":true,"iamRef":"iam-check-reference","backupRestoreVerified":true,"backupRestoreRef":"restore-drill-reference","serviceAccountEmail":"approved-sa@freepasserp5.iam.gserviceaccount.com","productionOrigin":"https://freepass-admin.vercel.app","approvalRef":"ops-ticket-or-receipt","approvedAt":"2026-09-26T00:00:00.000Z","validUntil":"2026-10-03T00:00:00.000Z"}
# Never copy a sample as evidence. Bind only a receipt from the actual operational verification.
# ERP5_STORAGE_BUCKET=

# Login option A: approved Google Workspace OAuth.
GOOGLE_WORKSPACE_DOMAIN=teamjpk.com
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SESSION_SECRET=   # independent random secret, minimum 32 characters
# APP_BASE_URL=     # approved HTTPS Admin origin; callback: /login/google/callback

# Login option B: existing ERP4 Firebase Auth (freepasserp3), Admin authorization only.
AUTH_PROJECT_ID=freepasserp3
# AUTH_FIREBASE_SERVICE_ACCOUNT_JSON=
# AUTH_SERVICE_ACCOUNT_PATH=
# FIREBASE_WEB_API_KEY=
# ADMIN_EMAILS=
# ADMIN_UIDS=
# Production authentication is always enforced; do not create a bypass for deployment.
# ADMIN_AUTH=on   # local dev only: enforce login outside production as well

# Set both to the approved HTTPS Admin origin before issuing external links.
# PUBLIC_BASE_URL=
# CLAIM_LINK_BASE=
# NEXT_PUBLIC_APP_URL=   # legacy fallback for PUBLIC_BASE_URL; prefer PUBLIC_BASE_URL

# E-sign is outside the launch scope (2026-09-25). Admin list, customer /sign links and esign APIs return 404 unless on.
ESIGN_ENABLED=off

# Final PDF renderer controls have safe bounded defaults.
# ESIGN_PDF_RENDER_TIMEOUT_MS=45000
# ESIGN_PDF_LAUNCH_TIMEOUT_MS=30000
# ESIGN_PDF_TOTAL_TIMEOUT_MS=65000
# ESIGN_CHROMIUM_EXECUTABLE_PATH=   # optional local Chromium; serverless uses @sparticuz/chromium
# Never set emulator host variables (FIRESTORE_EMULATOR_HOST, FIREBASE_STORAGE_EMULATOR_HOST) in the production environment.
# FPA_DEMO=on is development/preview only and must never be bound to production.
