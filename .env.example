# FreePass Admin environment contract
#
# Never copy credentials from freepasserp4 or any legacy project.
# ERP5 binding is explicit and fail-closed.

# Development default: file
# Production must explicitly select erp5 or remains unbound.
FPA_REPOSITORY_MODE=file
FPA_DATA_DIR=.data
FPA_DEV_ACTOR_ID=dev-admin
# Development reference master is explicit; free text is not authoritative.
FPA_DEV_SALES_CHANNEL_IDS=channel-dev
# Optional additional development assignees.
# FPA_DEV_ASSIGNEE_IDS=dev-admin-2

# ERP5 read/write binding
# FPA_REPOSITORY_MODE=erp5
# ERP5_FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"freepasserp5",...}
# or local development only:
# ERP5_SERVICE_ACCOUNT_PATH=/secure/path/freepasserp5-service-account.json

# Required before Admin-owned write collections can be used.
# This creates/uses only namespaced Admin collections such as
# <namespace>_applications, <namespace>_performances, <namespace>_settlements.
# ERP5_ADMIN_NAMESPACE=freepass_admin_v1

# Write gate. Omit/off = all Admin ERP5 mutations fail closed.
# ERP5_WRITE=on

# Production authentication is intentionally NOT configured by the persistence flags above.
# A production Actor/Auth adapter remains a separate required gate.


# Production Admin authentication
# Production defaults to UNBOUND until this is explicitly set.
# FPA_AUTH_MODE=firebase
# FPA_AUTH_PROJECT_ID=<independent-auth-project-id>
# FPA_AUTH_WEB_API_KEY=<firebase-web-api-key>
# FPA_AUTH_SERVICE_ACCOUNT_JSON={"project_id":"<same-project-id>",...}
# or local development only:
# FPA_AUTH_SERVICE_ACCOUNT_PATH=/secure/path/admin-auth-service-account.json
#
# Administrator authority is UID-based only.
# Email addresses alone never grant admin access.
# FPA_ADMIN_UIDS=uid-1,uid-2


# Catalog read source can migrate independently from Admin operational writes.
# Default follows FPA_REPOSITORY_MODE for backward compatibility.
# FPA_PRODUCT_SOURCE=erp5
#
# Future FreePass Data read cutover:
# FPA_PRODUCT_SOURCE=freepass-data
# FREEPASS_DATA_BASE_URL=https://data.internal.example
# Production requires a service credential once the Data API IAM contract is active.
# FREEPASS_DATA_SERVICE_TOKEN=<service-token>
#
# The required consumer endpoint contract is:
# GET /v1/views/admin-catalog/products
# schema = freepass-data.admin-catalog/v1
#
# Do not point Admin at FreePass Data internal Firestore collection paths.
