      "workspaceGapPx": 8,
      "workspacePaddingPx": 8,
      "panelPaddingPx": 16
    },
    "roles": [
      "LIST",
      "DETAIL",
      "WORK"
    ],
    "layouts": {
      "products": "2/3 list + 1/3 detail",
      "intake": "product list + product detail + intake/work",
      "settlement": "group + performance lines + intake detail",
      "esign": "2/3 list + 1/3 detail"
    }
  },
  "listRow": {
    "component": "src/app/_design/ListRow.tsx",
    "outerPaddingPx": 12,
    "bodyHeightPx": 64,
    "renderedHeightApproxPx": 88,
    "gapPx": 8,
    "productThumb": {
      "widthPx": 82,
      "heightPx": 64
    },
    "statusTile": {
      "widthPx": 64,
      "heightPx": 64
    }
  },
  "navigation": {
    "desktop": [
      "상품찾기",
      "계약접수",
      "정산관리",
      "전자계약"
    ],
    "mobile": [
      "상품",
      "접수",
      "계약",
      "청구",
      "지급"
    ],
    "mobileDepthRule": "depth0 global tabs; depth1/2 panel action bar"
  },
  "components": {
    "canonical": [
      "AdminChrome",
      "TopMenu",
      "MobileTabBar",
      "ListRow",
      "StatusTile",
      "Tag",
      "PerkMarks",
      "Icon",
      "FilterSheet",
      "OfferPicker",
      "DetailTabs",
      "PhotoGallery"
    ],
    "extractionCandidates": [
      "PanelHeader",
      "SearchBox",
      "ActionBar",
      "EmptyState",
      "SummaryGrid",
      "Notice"
    ]
  },
  "colorSemantics": {
    "selected": "navy",
    "primary": "navy",
    "success": "green",
    "warning": "amber/red with text",
    "destructive": "red with explicit text"
  },
  "rules": {
    "onePrimaryPerPanel": true,
    "bordersMostly": [
      "panel",
      "search"
    ],
    "listSelectionBySurface": true,
    "mobileOnePanelAtATime": true,
    "doNotCreateNewVisualScaleWithoutUpdatingSSOT": true
  },
  "knownDebt": [
    "globals.css contains legacy rules overridden later by final rules",
    "UI-SPEC still contains historical specs below the current-baseline section",
    "row body height 64 vs rendered row about 88 needs explicit terminology",
    "some mobile back/compact controls have visual size below 44px touch target",
    "--박스 and --카드 must keep separate roles: info box vs list row"
  ]
