# FreePass Admin operational environment contract (2026-09-25)
# Values below are placeholders, not working production credentials.
# Provision approved secrets in the deployment project; never commit .env.local.
# The Catalog authority is FreePass Data. Admin owns workflow commands and audit.

FREEPASS_DATA_ADMIN_CATALOG_READ_MODE=OBSERVE
# OBSERVE serves the explicit read-only freepasserp5 legacy catalog bridge.
# Final catalog cutover requires an approved Admin contract, parity and ACTIVE release.
# FREEPASS_DATA_BASE_URL=
# FREEPASS_DATA_ADMIN_CATALOG_TOKEN=

# Shared FreePass Data Firestore project: freepasserp5.
# Set JSON in the deployment secret store OR a local approved key-file path, never both.
# ERP5_FIREBASE_SERVICE_ACCOUNT_JSON=
# ERP5_SERVICE_ACCOUNT_PATH=
ERP5_WRITE=off
# Explicitly approve runtime/IAM/write tests before switching ERP5_WRITE=on.
# ERP5_STORAGE_BUCKET=

# Login option A: approved Google Workspace OAuth.
GOOGLE_WORKSPACE_DOMAIN=teamjpk.com
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SESSION_SECRET=   # independent random secret, minimum 32 characters
# APP_BASE_URL=     # approved HTTPS Admin origin; callback: /login/google/callback

# Login option B: existing ERP4 Firebase Auth (freepasserp3), Admin authorization only.
AUTH_PROJECT_ID=freepasserp3
# AUTH_FIREBASE_SERVICE_ACCOUNT_JSON=
# AUTH_SERVICE_ACCOUNT_PATH=
# FIREBASE_WEB_API_KEY=
# ADMIN_EMAILS=
# ADMIN_UIDS=
# Production authentication is always enforced; do not create a bypass for deployment.

# Set both to the approved HTTPS Admin origin before issuing external links.
# PUBLIC_BASE_URL=
# CLAIM_LINK_BASE=

# Final PDF renderer controls have safe bounded defaults.
# ESIGN_PDF_RENDER_TIMEOUT_MS=45000
# ESIGN_PDF_LAUNCH_TIMEOUT_MS=30000
# ESIGN_PDF_TOTAL_TIMEOUT_MS=65000
# Never set emulator host variables in the production environment.
