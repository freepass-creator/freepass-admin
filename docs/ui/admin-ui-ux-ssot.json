    "salesAppIsVisualBaseline": true
  },
  "knownDebt": [
    "globals.css contains legacy rules overridden later by final rules",
    "UI-SPEC still contains historical specs below the current-baseline section",
    "row body height 64 vs rendered row about 88 needs explicit terminology",
    "--박스 and --카드 must keep separate roles: info box vs list row"
  ],
  "implementedFixes": [
    "CSS exposes shared --ui-* aliases without changing current visual values",
    "ListRow dimensions route through shared UI tokens",
    "support text outliers in status/internal/article labels normalized to 12px",
    "mobile back visual remains 32px but hit area is expanded to 44px",
    "core products/intake/settlement/esign routes use shared visual primitives",
    "CI runs typecheck, tests, and UI SSOT regression check",
    "globals.css legacy base layer is explicitly marked as non-authoritative",
    "shared primitives replace repeated markup across core routes",
    "FilterSheet restores focus to trigger and uses per-instance dialog ids",
    "DetailTabs exposes tab semantics",
    "ListRow exposes selected state semantics",
    "pending forms expose busy state and side-step buttons prevent duplicate submission",
    "PhotoGallery arrow pointer event no longer opens lightbox accidentally",
    "PhotoGallery and global CSS honor reduced motion",
    "global focus-visible treatment is standardized",
    "stable inline visual styles moved to shared CSS classes",
    "badge/list/section icon names are partially compile-time constrained with IconName",
    "AGENTS, MASTER and WORK-INBOX explicitly defer visual standards to the current UI SSOT"
  ],
  "automation": {
    "command": "npm run ui:check",
    "workflow": ".github/workflows/ci.yml",
    "checks": [
      "core routes do not reintroduce raw panel-head/dz-bar/dz-empty/summary-grid markup",
      "required --ui-* CSS tokens exist",
      "machine SSOT baseline remains 18/14/12, control/action/touch 44, control radius 6, panel radius 4",
      "stable core UI files do not reintroduce inline visual styles",
      "focus-visible and reduced-motion rules exist"
    ]
  },
  "accessibility": {
    "focusVisible": true,
    "reducedMotion": true,
    "filterSheetFocusReturn": true,
    "filterSheetFocusEntry": true,
    "filterSheetFocusTrap": true,
    "uniqueDialogIds": true,
    "tabSemantics": true,
    "tabArrowNavigation": true,
