  },
  "components": {
    "canonical": [
      "Screen",
      "Panel",
      "PanelHead",
      "PanelBody",
      "PanelFoot",
      "SearchBar",
      "QuickFilter",
      "AutoSelect",
      "RowCards",
      "RowCard",
      "Tile",
