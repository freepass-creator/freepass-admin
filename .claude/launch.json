{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "freepass-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4321",
        "--directory",
        "docs/ui/mockups"
      ],
      "port": 4321
    },
    {
      "name": "fp-settlement",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/dev/fp-settlement",
        "run",
        "dev"
      ],
      "port": 4010
    }
  ]
}
